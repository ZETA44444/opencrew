# OpenCrew launcher: the only container with access to Docker (fixed operations only).
FROM node:22-alpine
RUN apk add --no-cache docker-cli tini
WORKDIR /app
COPY server/launcher.mjs server/computer.mjs server/sandbox.mjs ./server/
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server/launcher.mjs"]
