{$OPENCREW_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	redir /puente /puente/
	handle /puente/* {
		reverse_proxy puente:8790 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy opencrew:8787 {
			flush_interval -1
		}
	}
}
